rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Only authenticated users can access patient records
    match /patients/{patientId} {
      allow read, list: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['patientName', 'mobile', 'visitType', 'createdAt'])
        && request.resource.data.patientName is string
        && request.resource.data.patientName.size() > 0
        && request.resource.data.mobile is string
        && request.resource.data.mobile.size() >= 10;
      allow update: if request.auth != null
        && request.resource.data.patientName is string
        && request.resource.data.patientName.size() > 0;
      allow delete: if request.auth != null && request.auth.token.email == 'admin@blueteeth.in';
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
